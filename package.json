{
  "name": "lex-outliner-desktop",
  "productName": "Lex Outliner",
  "version": "1.2.2",
  "description": "Lex Outliner for the Mac: the web app in its own window, with Touch Bar buttons.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --universal --publish never",
    "test": "node test/backup.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.nicholasgirard.lexoutliner",
    "productName": "Lex Outliner",
    "files": [
      "main.js",
      "preload.js",
      "update.js",
      "backup.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
